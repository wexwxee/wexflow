@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
echo ============================================================
echo   ОТКАТ приложения WexFlow (ПК) к состоянию ДО правила
echo   "первая подача — с подтверждением и квитанцией" (08.08.2026).
echo.
