@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
echo ============================================================
echo   ОТКАТ приложения WexFlow (ПК) к состоянию ДО доработки
echo   "телефон-first" (панель/лента с телефона).
echo.
echo   Вернёт код к метке phone-first-base-20260721.
echo   Все правки этапов телефон-панели будут отменены.
echo   Твои личные данные (%%AppData%%\WexFlow) НЕ трогаются.
echo ============================================================
echo.
set /p ANS=Точно откатить? Напиши YES и Enter:
if /I not "%ANS%"=="YES" ( echo Отмена. Ничего не менял. & pause & exit /b 0 )
echo.
git reset --hard phone-first-base-20260721
if errorlevel 1 ( echo НЕ удалось откатить. Напиши в поддержку. & pause & exit /b 1 )
echo.
echo Готово: код вернулся к базовой метке.
echo Чтобы это увидел установленный WexFlow — пересобери дистрибутив
echo (СОБРАТЬ_ДИСТРИБУТИВ.bat) или просто пользуйся текущей установленной версией.
echo.
pause
